# ============================================================
# VERALUZ SaaS V2 — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# NE JAMAIS committer .env.local ou toute valeur secrète.
# ============================================================

# ----- Application -----
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
# NOTE: La version applicative vient de package.json — pas de variable ici.

# ----- Multi-tenancy (hint UX uniquement — jamais un token d'autorisation) -----
NEXT_PUBLIC_TENANT_ID=

# ----- Feature flags -----
# Valeurs acceptées : "true" ou "false" UNIQUEMENT.
# "True", "yes", "1" sont rejetés par la validation Zod.
NEXT_PUBLIC_FEATURE_MAINTENANCE=false

# ── F1+ — variables inutilisées en F0 ────────────────────────────────────────
# Ces variables sont des placeholders pour le lot F1 (Supabase Auth).
# En F0, aucune connexion Supabase n'est établie.
# NEXT_PUBLIC_* = non-secret (bundlé côté client par Next.js).

# URL du projet Supabase (local: généré par `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé anon Supabase (publique, non-secrète)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ─────────────────────────────────────────────────────────────────────────────
