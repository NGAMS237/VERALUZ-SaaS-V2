# ============================================================
# VERALUZ SaaS V2 — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# NE JAMAIS committer .env.local ou toute valeur secrète.
# ============================================================

# ----- Application -----
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0

# ----- Multi-tenancy -----
# Identifiant du tenant courant (ex: veraluz-001)
NEXT_PUBLIC_TENANT_ID=

# ----- Supabase (local dev uniquement pour F0) -----
# Généré par `supabase start` — ne pas pointer sur PROD
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- KJEMO API -----
# Clé interne pour les appels serveur-à-serveur de l'API kjemo
KJEMO_API_SECRET=

# ----- Feature flags (optionnel) -----
NEXT_PUBLIC_FEATURE_MAINTENANCE=false
