# .env.example — Variables d'environnement VERALUZ SaaS V2
# Copier vers .env.local et remplir les vraies valeurs.
# Ne jamais committer .env.local — il est exclu via .gitignore.
# Ne jamais mettre de vraies clés dans ce fichier.

# ─── Environnement applicatif ───────────────────────────────────────────────
APP_ENV=development

# ─── Supabase (local) ────────────────────────────────────────────────────────
# URL locale : obtenue via `supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé anon locale (publishable) : obtenue via `supabase start`
# Cette clé est publique par construction — jamais la service_role ici.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clé-anon-locale-supabase-start>

# ─── Tenant UX hint ──────────────────────────────────────────────────────────
# Hint UX/routing uniquement — jamais utilisé comme autorisation.
NEXT_PUBLIC_TENANT_ID=

# ─── Maintenance ─────────────────────────────────────────────────────────────
# Valeurs acceptées : "true" ou "false" uniquement (strict)
FEATURE_MAINTENANCE=false
