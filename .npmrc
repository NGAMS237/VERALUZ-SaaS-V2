# pnpm supply-chain security
# Require 24h minimum package age before installation.
# See: https://docs.pnpm.io/npmrc#minimumreleaseage
minimumReleaseAge=1440

# Explicitly allow post-install build scripts for trusted native build tools.
# esbuild: compiles JS bundler from Go sources.
# unrs-resolver: compiles resolver from Rust sources.
# Both are well-known, audited tools required by Next.js.
ignoredBuiltDependencies[]=esbuild
ignoredBuiltDependencies[]=unrs-resolver
