{
  "name": "veraluz-v2",
  "version": "0.1.0",
  "private": true,
  "description": "VERALUZ SaaS V2 — Plateforme multi-tenant de gestion résidentielle",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11"
  }
}
